# Copy to `.env` and fill in. `.env` is git-ignored — never commit real secrets.
# docker-compose injects the in-network DATABASE_URL / REDIS_URL itself, so for a
# pure `docker compose up` you only need the provider keys below.

# --- App ---------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

# --- Datastores (non-secret local dev defaults; compose overrides for Docker) -
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot
REDIS_URL=redis://localhost:6379/0

# --- HTTP --------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173"]

# --- Providers (SECRETS — wired in slice 7; leave empty until then) ----------
OPENAI_API_KEY=
TAVILY_API_KEY=

# --- Frontend (Vite) ---------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
