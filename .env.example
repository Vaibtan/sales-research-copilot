# Copy to `.env` and fill in. `.env` is git-ignored — never commit real secrets.
# docker-compose injects the in-network DATABASE_URL / REDIS_URL itself, so for a
# pure `docker compose up` you only need the provider keys below.

# --- App ---------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

# --- Datastores (non-secret local dev defaults; compose overrides for Docker) -
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot
REDIS_URL=redis://localhost:6379/0

# --- HTTP --------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173"]

# --- Workflow ----------------------------------------------------------------
# HITL plan-approval: when true the run pauses after planning for human review/
# edit of the research questions. Set false to auto-approve (straight through).
HITL_PLAN_APPROVAL=true

# --- Providers (SECRETS) -----------------------------------------------------
# With BOTH set, the app uses the live OpenAI + Tavily backends; otherwise it
# runs the deterministic mocks (no network). Model ids are verified at boot.
OPENAI_API_KEY=
TAVILY_API_KEY=

# --- Models (optional overrides; defaults shown) -----------------------------
# Per-node model ids — verified against the live API at boot (fail-fast on a bad
# id). `analyze` steps up to a stronger model for synthesis (§15).
# MODEL_PLAN=gpt-5-nano
# MODEL_EXTRACT=gpt-5-nano
# MODEL_ANALYZE=gpt-5
# MODEL_QUALITY=gpt-5-nano
# MODEL_CHAT=gpt-5-nano
# MODEL_EMBEDDING=text-embedding-3-small
# VERIFY_MODELS_ON_BOOT=true
# RETRY_MAX_ATTEMPTS=3

# --- Frontend (Vite) ---------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
